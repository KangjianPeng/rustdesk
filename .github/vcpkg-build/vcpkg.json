{
  "name": "rustdesk-build-dependencies",
  "version-string": "1.0.0",
  "dependencies": [
    "aom",
    {
      "name": "ffmpeg",
      "features": [
        {
          "name": "amf",
          "platform": "windows"
        },
        {
          "name": "nvcodec",
          "platform": "windows"
        },
        {
          "name": "qsv",
          "platform": "windows"
        }
      ],
      "platform": "windows | osx"
    },
    "libvpx",
    "libyuv"
  ],
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "builtin",
      "baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d"
    },
    "overlay-ports": [
      "../../res/vcpkg"
    ],
    "overlay-triplets": [
      "../../res/vcpkg-triplets"
    ]
  }
}
